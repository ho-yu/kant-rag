# 공용 서버의 프로젝트 루트에 .env로 복사 후 실제 연결 정보와 인증 키 설정
# 웹 화면만 사용하는 개인 PC에는 코드 실행과 환경변수 설정 불필요
# 실제 인증 키는 .env에만 입력하며 Git 공유 대상에서 제외

# 서버 설정 — 답변 모델과 검사 모델의 OpenAI API 호출
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# 서버 설정 — 실행 기록을 저장할 Langfuse 주소와 프로젝트 인증 키
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="http://10.2.17.122:3000"

# 서버 설정 — 검색 자료가 저장된 Qdrant 주소와 인증 키
QDRANT_URL=http://10.2.17.122:6333/
QDRANT_API_KEY=

# 서버 설정 — 백엔드 실행에 필수인 서비스 접속 키
# OpenAI 키와 별개로 지정하며 화면과 평가 코드의 X-API-Key에 동일한 값 사용
RAG_API_KEY=
# API 호출 설정 — 같은 서버에서 실행하는 Streamlit 화면의 백엔드 주소
# 개인 PC의 평가 코드에서는 http://10.2.17.122:8000 및 동일한 RAG_API_KEY 사용
RAG_API_URL=http://127.0.0.1:8000
# API 응답 대기 제한 단위 초
RAG_API_TIMEOUT=600

# 서버 설정 — 답변 모델과 검사 모델의 추론 강도
RAG_REASONING_EFFORT=low
# 모델 요청 제한 시간 단위 초
RAG_MODEL_TIMEOUT=120
# 최초 호출 실패 후 추가 재시도 횟수
RAG_MODEL_RETRIES=1
# 검색 문맥 길이와 별개인 모델 출력 토큰 상한
RAG_OUTPUT_TOKENS=4096
# 서버 프로세스의 동시 요청 수 상한이며 초과 요청에는 HTTP 429 반환
RAG_MAX_CONCURRENT_REQUESTS=16

# 서버 설정 — 세 난이도와 세 검색 방식의 시작 시 사전 준비
# 난이도별 순차 준비 완료 후 요청 수신으로 첫 요청의 초기화 대기 완화
# 준비 범위에 따른 서버 시작 시간과 메모리 사용량 증가
RAG_WARMUP_DIFFICULTIES=basic,intermediate,advanced
# 빈 값 지정 시 사전 준비 생략 및 최초 사용 시 검색 자원 준비
RAG_WARMUP_MODES=naive,hybrid,hybrid_rerank
