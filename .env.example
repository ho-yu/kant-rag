# 답변 LLM (사용하는 서비스에 맞게 이름 조정)
OPENAI_API_KEY=
OPENAI_MODEL=

# Langfuse (클라우드면 https://cloud.langfuse.com, 로컬이면 http://localhost:3000)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Qdrant (클라우드를 쓸 때만, 로컬 모드면 비워둠)
QDRANT_URL=
QDRANT_API_KEY=

# retrieval_b 검색 설정 (src/rag_service/retrieval_b/settings.py)
# 비우거나 줄을 지우면 코드 기본값을 쓴다. 바꾼 뒤에는 서버·커널을 다시 시작해야 반영된다.
# 최종으로 돌려줄 청크 수
RETRIEVAL_B_K=5
# 검색할 청크 레벨, page·para·table·row·sent 중 쉼표로 구분
RETRIEVAL_B_LEVELS=para,table
# Hybrid가 Dense·BM25에서 각각 뽑는 후보 수
RETRIEVAL_B_CANDIDATE_K=30
# RRF 상수, 0 이상
RETRIEVAL_B_RRF_K=60
# 리랭커에 넘길 Hybrid 후보 수, RETRIEVAL_B_K 이상
RETRIEVAL_B_RERANK_N=50
# 리랭커 입력 최대 토큰 수
RETRIEVAL_B_RERANK_MAX_LENGTH=1024
# 리랭커 배치 크기
RETRIEVAL_B_RERANK_BATCH_SIZE=16

# retrieval_b 모델
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
